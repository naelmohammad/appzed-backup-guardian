{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appzed-backup-guardian",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appzed-backup-guardian-meta"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
